# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# SatuSehat Integration - Sandbox Credentials
# Get these from: https://developer.kemkes.go.id
SATUSEHAT_CLIENT_ID=your_sandbox_client_id_here
SATUSEHAT_CLIENT_SECRET=your_sandbox_client_secret_here
SATUSEHAT_BASE_URL=https://api-sandbox.kemkes.go.id
SATUSEHAT_ORGANIZATION_ID=your_organization_id_here

# BPJS Integration (Optional - for BPJS features)
BPJS_CONS_ID=your_bpjs_cons_id
BPJS_SECRET_KEY=your_bpjs_secret_key
BPJS_USER_KEY=your_bpjs_user_key
NEXT_PUBLIC_BPJS_PPK_CODE=your_ppk_code

# Payment Gateway (Optional - for Midtrans integration)
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key

# Note:
# - Copy this file to .env.local
# - Replace xxx_here values with your actual credentials
# - Never commit .env.local to git
# - .env.local is git-ignored for security
